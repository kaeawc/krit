# `bazel run @krit//:krit -- <args>` runs the prebuilt binary for the host.
alias(
    name = "krit",
    actual = "@krit_bin//:krit",
    visibility = ["//visibility:public"],
)

alias(
    name = "krit-lsp",
    actual = "@krit_bin//:krit-lsp",
    visibility = ["//visibility:public"],
)

alias(
    name = "krit-mcp",
    actual = "@krit_bin//:krit-mcp",
    visibility = ["//visibility:public"],
)

exports_files([
    "defs.bzl",
    "extensions.bzl",
])

# The krit-fir jar of the same release, for type-aware rules.
alias(
    name = "krit_fir_jar",
    actual = "@krit_fir//:krit-fir.jar",
    visibility = ["//visibility:public"],
)
