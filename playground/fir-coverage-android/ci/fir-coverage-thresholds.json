    "bazel-krit_aspect": {"minAuthoritative": 0, "minCoverage": 0.0}
  },
  "checks": {
    "gradle-configuration-cache": {"required": false},
    "gradle-up-to-date": {"required": true},
    "bazel-action-cache": {"required": true},
    "bazel-krit_aspect-cache": {"required": false}
  }
}
