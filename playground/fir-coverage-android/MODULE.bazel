"""Bazel side of the dual-build FIR coverage sample (see README.md).

The same sources build with Gradle (settings.gradle.kts). Package //x
matches Gradle project :x.
"""

module(name = "krit_fir_coverage_android")

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_android", version = "0.8.1")

# krit's Bazel module from this checkout.
bazel_dep(name = "krit")
local_path_override(
    module_name = "krit",
    path = "../../bazel",
)

# The krit module downloads a release binary and krit-fir jar; use the ones
# built from this checkout instead (`make fir-jar`, then copy krit-fir.jar
# next to krit): `go build -o playground/fir-coverage-android/.krit-bin/dist/krit ./cmd/krit`
# (the same dist/ layout as the release repository).
krit = use_extension("@krit//:extensions.bzl", "krit")

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

# krit from this checkout, standing in for the krit module's krit_toolchains
# repository (override_repo below): the toolchain krit_aspect resolves, which
# the krit module registers, and the `krit` binary krit_test and
# `bazel run @krit//:krit` use.
new_local_repository(
    name = "krit_local_bin",
    build_file_content = """
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@krit//:defs.bzl", "krit_toolchain")

native_binary(
    name = "krit_exe",
    src = "dist/krit",
    out = "krit_bin",
)

alias(
    name = "krit",
    actual = ":krit_exe",
    visibility = ["//visibility:public"],
)

krit_toolchain(
    name = "krit_toolchain",
    krit = ":krit_exe",
)

toolchain(
    name = "toolchain",
    toolchain = ":krit_toolchain",
    toolchain_type = "@krit//toolchains:toolchain_type",
)
""",
    path = ".krit-bin",
)

# krit_aspect's krit-fir jar, from the same build (.krit-bin/dist/krit-fir.jar).
new_local_repository(
    name = "krit_local_fir",
    build_file_content = """exports_files(["krit-fir.jar"])""",
    path = ".krit-bin/dist",
)

override_repo(
    krit,
    krit_fir = "krit_local_fir",
    krit_toolchains = "krit_local_bin",
)

register_toolchains("//:kotlin_toolchain")

remote_android_extensions = use_extension("@rules_android//bzlmod_extensions:android_extensions.bzl", "remote_android_tools_extensions")
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
android_sdk_repository_extension.configure(
    api_level = 36,
    build_tools_version = "36.0.0",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")

# Versions match gradle/libs.versions.toml.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.test.ext:junit:1.3.0",
        "androidx.test:core:1.7.0",
        "androidx.test:runner:1.7.0",
        "com.squareup.moshi:moshi-kotlin-codegen:1.15.2",
        "com.squareup.moshi:moshi:1.15.2",
        "com.squareup.wire:wire-compiler:7.2.2",
        "com.squareup.wire:wire-runtime-jvm:7.2.2",
        "junit:junit:4.13.2",
        "org.jetbrains.kotlinx:kotlinx-serialization-json-jvm:1.11.0",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "maven")
