load("@krit//:defs.bzl", "krit_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Runs the downloaded binary with --version.
sh_test(
    name = "krit_version_test",
    srcs = ["krit_version_test.sh"],
    args = ["$(rootpath @krit//:krit)"],
    data = ["@krit//:krit"],
)

# krit_test reads the srcs of the targets it is given; any rule with a srcs
# attribute (kt_jvm_library, java_library, filegroup) works the same way.
filegroup(
    name = "clean_sources",
    srcs = ["src/Clean.kt"],
)

krit_test(
    name = "clean_krit_test",
    targets = [":clean_sources"],
)

# Has a finding (UnsafeCallOnNullableType), so it fails; run only through
# krit_test_reports_findings_test, which expects that.
krit_test(
    name = "unsafe_krit_test",
    srcs = ["src/Unsafe.kt"],
    tags = ["manual"],
)

# The same file passes with a config that turns the rule off.
krit_test(
    name = "configured_krit_test",
    srcs = ["src/Unsafe.kt"],
    config = "krit.yml",
)

sh_test(
    name = "krit_test_reports_findings_test",
    srcs = ["krit_test_reports_findings_test.sh"],
    args = ["$(rootpath :unsafe_krit_test)"],
    data = [":unsafe_krit_test"],
)

# krit skips test-data directories, so this analyzes nothing and must fail
# rather than pass vacuously; run only through
# krit_test_rejects_empty_scan_test.
krit_test(
    name = "skipped_krit_test",
    srcs = ["testdata/Skipped.kt"],
    tags = ["manual"],
)

sh_test(
    name = "krit_test_rejects_empty_scan_test",
    srcs = ["krit_test_rejects_empty_scan_test.sh"],
    args = ["$(rootpath :skipped_krit_test)"],
    data = [":skipped_krit_test"],
)
