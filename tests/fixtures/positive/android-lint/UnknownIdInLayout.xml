<?xml version="1.0" encoding="utf-8"?>
<!-- Positive fixture: layout_below references @id/title, which is declared in
     another layout (res/layout/header.xml) but not in this one, and this
     layout has no <include>. The reference resolves at build time but never
     at runtime, so UnknownIdInLayout warns. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/title" />
</RelativeLayout>
