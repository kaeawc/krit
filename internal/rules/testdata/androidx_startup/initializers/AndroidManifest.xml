<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" package="com.example">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35"/>
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data android:name="com.example.ListedInitializer" android:value="androidx.startup" />
            <meta-data android:name="com.example.JavaListed" android:value="@string/androidx_startup" />
            <meta-data android:name=".RelativeInitializer" android:value="androidx.startup" />
            <meta-data android:name="com.example.WrongValue" android:value="other" />
        </provider>
    </application>
</manifest>
