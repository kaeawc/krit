"""End-to-end check of the krit module.

In the Bazel Central Registry presubmit this tests the module version under
review. Locally the overridden module is unreleased (0.0.0), so name a
published release to download:

    KRIT_BAZEL_RELEASE=0.2.0 bazel test //...
"""

module(name = "krit_e2e")

bazel_dep(name = "krit")
local_path_override(
    module_name = "krit",
    path = "..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "6.9", dev_dependency = True)

# bazel_worker_java (a dependency of rules_kotlin) resolves its Maven
# artifacts with Coursier at fetch time. Coursier downloads outside Bazel's
# downloader, so --downloader_config cannot redirect it, and Maven Central
# answers shared CI runner IPs with 429 Too Many Requests. The root module's
# repositories replace that install's: resolve it from Google's mirror of
# Maven Central instead.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)
maven.install(
    name = "bazel_worker_maven",
    known_contributing_modules = ["bazel_worker_java", "krit_e2e"],
    repositories = ["https://maven-central.storage-download.googleapis.com/maven2"],
)
