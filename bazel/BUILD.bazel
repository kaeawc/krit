load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "int_flag", "string_flag")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

# `bazel run @krit//:krit -- <args>` runs the release binary for the target
# platform (the host, by default). krit_aspect and krit_project_report run
# krit from the krit toolchain of their actions' execution platform instead.
alias(
    name = "krit",
    actual = "@krit_toolchains//:krit",
    visibility = ["//visibility:public"],
)

alias(
    name = "krit-lsp",
    actual = "@krit_toolchains//:krit-lsp",
    visibility = ["//visibility:public"],
)

alias(
    name = "krit-mcp",
    actual = "@krit_toolchains//:krit-mcp",
    visibility = ["//visibility:public"],
)

exports_files([
    "defs.bzl",
    "extensions.bzl",
])

# The krit-fir jar of the same release, for type-aware rules.
alias(
    name = "krit_fir_jar",
    actual = "@krit_fir//:krit-fir.jar",
    visibility = ["//visibility:public"],
)

# Settings of krit_aspect (see private/krit_aspect.bzl), e.g.
#   --@krit//:config=//:krit.yml --@krit//:fail_on_findings
label_flag(
    name = "config",
    build_setting_default = ":no_file",
    visibility = ["//visibility:public"],
)

label_flag(
    name = "baseline",
    build_setting_default = ":no_file",
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "fail_on_findings",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "fir",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "no_file",
    srcs = [],
)

# `bazel run @krit//:export_model -- //...` writes .krit/bazel-model/ for
# krit, krit-lsp and krit-mcp scans outside Bazel (see private/export_model.sh).
native_binary(
    name = "export_model",
    src = "//private:export_model.sh",
    out = "export_model.sh",
    visibility = ["//visibility:public"],
)

# krit_aspect's Krit actions run as persistent workers (one warm krit-fir JVM
# per worker); false runs each action with its own JVM.
bool_flag(
    name = "worker",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# Which rules krit_aspect's per-target actions run: "file" (the file-scope
# rules; krit_project_report runs the project-scope ones over the whole
# build) or "all".
string_flag(
    name = "scope",
    build_setting_default = "file",
    values = [
        "all",
        "file",
    ],
    visibility = ["//visibility:public"],
)

# krit_aspect's Krit actions that scan at least this many files are "large":
# they run in the `krit_large` exec group, so a remote execution platform's
# `krit_large.<key>` exec_properties apply to them (a bigger worker, say),
# and Bazel schedules them locally with more memory.
int_flag(
    name = "large_target_sources",
    build_setting_default = 400,
    visibility = ["//visibility:public"],
)

# The Android minSdk / targetSdk of sources whose own manifest (in their
# directory or above) declares none, for krit_aspect's and
# krit_project_report's actions (krit --min-sdk / --target-sdk); 0 leaves
# them unknown. An android_binary's own action uses its manifest_values'
# minSdkVersion / targetSdkVersion instead, when they are numbers.
int_flag(
    name = "min_sdk_version",
    build_setting_default = 0,
    visibility = ["//visibility:public"],
)

int_flag(
    name = "target_sdk_version",
    build_setting_default = 0,
    visibility = ["//visibility:public"],
)
